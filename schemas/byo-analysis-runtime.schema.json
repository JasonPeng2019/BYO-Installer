{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BYO four-target analysis runtime mapping, schema version 1",
  "description": "Closed syntax for analysis/runtime.json. Release files is the sole payload digest inventory. Exact target/namespace/bytes, native format/ABI/dependency closure, modes, resource major/version, SBOM and probes require semantic verification. No implicit defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "architecture",
    "programs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "architecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cppcheck",
        "clangd"
      ],
      "properties": {
        "cppcheck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "executable",
            "cfg_dir",
            "platforms_dir",
            "licenses",
            "dependencies",
            "sbom_ref"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/version"
            },
            "executable": {
              "type": "string",
              "enum": [
                "analysis/cppcheck/cppcheck",
                "analysis/cppcheck/cppcheck.exe"
              ]
            },
            "cfg_dir": {
              "type": "string",
              "const": "analysis/cppcheck/cfg"
            },
            "platforms_dir": {
              "type": "string",
              "const": "analysis/cppcheck/platforms"
            },
            "licenses": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/relativePath"
                  },
                  {
                    "pattern": "^analysis/cppcheck/licenses/"
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "const": "analysis/cppcheck/licenses/COPYING"
                  }
                },
                {
                  "contains": {
                    "const": "analysis/cppcheck/licenses/simplecpp-LICENSE"
                  }
                },
                {
                  "contains": {
                    "const": "analysis/cppcheck/licenses/tinyxml2-LICENSE"
                  }
                },
                {
                  "contains": {
                    "const": "analysis/cppcheck/licenses/picojson-LICENSE"
                  }
                }
              ]
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "sbom_ref": {
              "type": "string",
              "const": "byo-analysis:cppcheck"
            }
          }
        },
        "clangd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "executable",
            "resource_dir",
            "licenses",
            "dependencies",
            "sbom_ref"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/version"
            },
            "executable": {
              "type": "string",
              "enum": [
                "analysis/clangd/bin/clangd",
                "analysis/clangd/bin/clangd.exe"
              ]
            },
            "resource_dir": {
              "type": "string",
              "pattern": "^analysis/clangd/lib/clang/[1-9][0-9]*$(?![\\s\\S])"
            },
            "licenses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {
                    "const": "analysis/clangd/LICENSE.TXT"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/clangd/licenses/"
                      }
                    ]
                  }
                ]
              },
              "contains": {
                "const": "analysis/clangd/LICENSE.TXT"
              }
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "sbom_ref": {
              "type": "string",
              "const": "byo-analysis:clangd"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))[^/\\\\<>:\"|?*\\u0000-\\u001f]+(?:/[^/\\\\<>:\"|?*\\u0000-\\u001f]+)*$(?![\\s\\S])"
    }
  },
  "oneOf": [
    {
      "properties": {
        "platform": {
          "const": "windows"
        },
        "architecture": {
          "const": "x86_64"
        },
        "programs": {
          "properties": {
            "cppcheck": {
              "properties": {
                "executable": {
                  "const": "analysis/cppcheck/cppcheck.exe"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/cppcheck/[^/]+\\.dll$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            },
            "clangd": {
              "properties": {
                "executable": {
                  "const": "analysis/clangd/bin/clangd.exe"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/clangd/bin/[^/]+\\.dll$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "platform": {
          "const": "macos"
        },
        "architecture": {
          "const": "aarch64"
        },
        "programs": {
          "properties": {
            "cppcheck": {
              "properties": {
                "executable": {
                  "const": "analysis/cppcheck/cppcheck"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/cppcheck/lib/[^/]+\\.dylib$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            },
            "clangd": {
              "properties": {
                "executable": {
                  "const": "analysis/clangd/bin/clangd"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/clangd/lib/[^/]+\\.dylib$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "platform": {
          "const": "macos"
        },
        "architecture": {
          "const": "x86_64"
        },
        "programs": {
          "properties": {
            "cppcheck": {
              "properties": {
                "executable": {
                  "const": "analysis/cppcheck/cppcheck"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/cppcheck/lib/[^/]+\\.dylib$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            },
            "clangd": {
              "properties": {
                "executable": {
                  "const": "analysis/clangd/bin/clangd"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/clangd/lib/[^/]+\\.dylib$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "platform": {
          "const": "linux"
        },
        "architecture": {
          "const": "x86_64"
        },
        "programs": {
          "properties": {
            "cppcheck": {
              "properties": {
                "executable": {
                  "const": "analysis/cppcheck/cppcheck"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/cppcheck/lib/[^/]+\\.so(?:\\.[0-9]+)*$(?![\\s\\S])"
                      }
                    ]
                  }
                },
                "licenses": {
                  "minItems": 6,
                  "allOf": [
                    {
                      "contains": {
                        "const": "analysis/cppcheck/licenses/GCC-COPYING3"
                      }
                    },
                    {
                      "contains": {
                        "const": "analysis/cppcheck/licenses/GCC-COPYING.RUNTIME"
                      }
                    }
                  ]
                }
              }
            },
            "clangd": {
              "properties": {
                "executable": {
                  "const": "analysis/clangd/bin/clangd"
                },
                "dependencies": {
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/relativePath"
                      },
                      {
                        "pattern": "^analysis/clangd/lib/[^/]+\\.so(?:\\.[0-9]+)*$(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
